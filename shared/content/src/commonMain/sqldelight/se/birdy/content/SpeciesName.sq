CREATE TABLE SpeciesName (
    species_id TEXT NOT NULL,
    locale TEXT NOT NULL,
    name TEXT NOT NULL,
    search_text TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (species_id, locale),
    FOREIGN KEY (species_id) REFERENCES Species(id) ON DELETE CASCADE
);

CREATE INDEX species_name_locale_name ON SpeciesName(locale, name);
CREATE INDEX species_name_search ON SpeciesName(search_text);

selectByLocale:
SELECT * FROM SpeciesName WHERE locale = ?;

selectBySpecies:
SELECT * FROM SpeciesName WHERE species_id = ?;

searchByName:
SELECT * FROM SpeciesName WHERE locale = ? AND name LIKE ('%' || ? || '%') ORDER BY name LIMIT ?;

searchByNameOrScientific:
SELECT sn.species_id AS species_id, sn.locale AS locale, sn.name AS name
FROM SpeciesName sn
JOIN Species s ON s.id = sn.species_id
WHERE sn.locale = :locale
  AND (sn.name LIKE ('%' || :query || '%') OR s.scientific_name LIKE ('%' || :query || '%'))
ORDER BY sn.name LIMIT :max;

selectAll:
SELECT * FROM SpeciesName;

insert:
INSERT INTO SpeciesName(species_id, locale, name, search_text) VALUES (?, ?, ?, ?);
