---
import { Image } from 'astro:assets';
import EyebrowLabel from './ui/EyebrowLabel.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import OrnamentRule from './ui/OrnamentRule.astro';
import { type Locale, getCopy } from '../lib/i18n';
import vc124Identify from '../assets/screens/vc124_identify.png';
import vc124Listen from '../assets/screens/vc124_listen.png';
import vc124Journal from '../assets/screens/vc124_journal.png';
import vc124Archive from '../assets/screens/vc124_archive.png';
import vc124Badges from '../assets/screens/vc124_badges.png';
import vc124Map from '../assets/screens/vc124_map.png';
import vc124Recap from '../assets/screens/vc124_recap.png';
import vc124Season from '../assets/screens/vc124_season.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale);

// Background-free, upright device cut-outs (the phone only) — v1.2 fresh
// screens: identify, listen, journal, archive, badges, map, recap, season.
const shots = [
  { src: vc124Identify, alt: t.alt.identifyScreen },
  { src: vc124Listen, alt: t.alt.listenScreen },
  { src: vc124Journal, alt: t.alt.journalScreen },
  { src: vc124Archive, alt: t.alt.archiveScreen },
  { src: vc124Badges, alt: t.alt.badgesScreen },
  { src: vc124Map, alt: t.alt.mapScreen },
  { src: vc124Recap, alt: t.alt.recapScreen },
  { src: vc124Season, alt: t.alt.seasonScreen },
];
---

<section id="glimpse" class="glimpse">
  <div class="head" data-reveal>
    <EyebrowLabel text={t.glimpse.eyebrow} />
    <JournalHeadline text={t.glimpse.headline} level="h2" />
    <p class="sub">{t.glimpse.sub}</p>
    <OrnamentRule />
  </div>

  <div class="strip-wrap" role="region" aria-label={t.glimpse.eyebrow}>
    <ul class="strip" role="list" data-glimpse>
      {shots.map((s, i) => (
        <li
          class={`card${i === 0 ? ' is-focus' : ''}`}
          data-idx={i}
          tabindex="0"
          role="button"
          aria-label={s.alt}
        >
          <Image
            src={s.src}
            alt={s.alt}
            widths={[360, 560, 760, 880]}
            sizes="(max-width: 640px) 56vw, 330px"
            quality={86}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </li>
      ))}
    </ul>
    <ol class="dots" role="tablist" aria-label={t.glimpse.eyebrow} data-glimpse-dots>
      {shots.map((_, i) => (
        <li>
          <button
            type="button"
            class={`dot${i === 0 ? ' is-focus' : ''}`}
            data-idx={i}
            aria-label={`${i + 1} / ${shots.length}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          ></button>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // Mark the card closest to the strip's horizontal center as "is-focus"
  // so CSS can dim its neighbors. Clicking any card (or dot) snaps it to the
  // centre. Works everywhere (no view-timeline dependency).
  const strips = document.querySelectorAll<HTMLElement>('[data-glimpse]');
  strips.forEach((strip) => {
    const cards = Array.from(strip.querySelectorAll<HTMLElement>('.card'));
    if (cards.length === 0) return;
    const wrap = strip.parentElement;
    const dotsRoot = wrap?.querySelector<HTMLElement>('[data-glimpse-dots]');
    const dots = dotsRoot
      ? Array.from(dotsRoot.querySelectorAll<HTMLButtonElement>('.dot'))
      : [];
    strip.dataset.jsActive = '';

    function centerCard(idx: number) {
      // scrollIntoView(inline:center) cooperates with scroll-snap mandatory;
      // a manual scrollBy gets snapped straight back to the current card.
      cards[idx]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }

    function updateFocus() {
      const sr = strip.getBoundingClientRect();
      const centerX = sr.left + sr.width / 2;
      let bestIdx = 0;
      let bestDist = Infinity;
      cards.forEach((card, idx) => {
        const r = card.getBoundingClientRect();
        const cc = r.left + r.width / 2;
        const d = Math.abs(cc - centerX);
        if (d < bestDist) {
          bestDist = d;
          bestIdx = idx;
        }
      });
      cards.forEach((card, idx) => {
        card.classList.toggle('is-focus', idx === bestIdx);
      });
      dots.forEach((dot, idx) => {
        const on = idx === bestIdx;
        dot.classList.toggle('is-focus', on);
        dot.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    let raf = 0;
    function schedule() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        updateFocus();
      });
    }
    strip.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('load', schedule);

    // Click / keyboard-activate any card to bring it to centre.
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => centerCard(idx));
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          centerCard(idx);
        }
      });
    });
    // Dots snap too.
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => centerCard(idx));
    });

    updateFocus();
  });
</script>

<style>
  .glimpse {
    padding: var(--section-padding-y) 0;
    max-width: 100%;
    margin: 0 auto;
  }
  .head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.5rem;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .sub {
    font-family: var(--font-script);
    font-size: 1.25rem;
    color: var(--color-marginalia-ink);
    margin: 0;
  }
  /*
   * Device strip — one upright handset centered with peeks of the neighbours.
   * Cards are sized by HEIGHT (auto width). Every device shares the same
   * aspect, so the row stays tidy. Any card can be clicked to centre it.
   */
  .strip-wrap {
    --card-w: clamp(180px, 52vw, 300px);
    --side-pad: max(1.25rem, calc(50% - var(--card-w) / 2));
    position: relative;
    margin-top: 2.5rem;
  }
  /* Soft fades on the sides so peek devices melt into the paper bg */
  .strip-wrap::before,
  .strip-wrap::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(2rem, 8vw, 6rem);
    pointer-events: none;
    z-index: 2;
  }
  .strip-wrap::before {
    left: 0;
    background: linear-gradient(90deg, var(--color-paper-bg) 0%, rgba(232, 226, 210, 0) 100%);
  }
  .strip-wrap::after {
    right: 0;
    background: linear-gradient(270deg, var(--color-paper-bg) 0%, rgba(232, 226, 210, 0) 100%);
  }
  .strip {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--side-pad);
    padding: 1.5rem var(--side-pad) 2rem;
    list-style: none;
    margin: 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  /*
   * Transparent device cut-outs (no card frame). The focused handset stands
   * full-height; neighbours shrink and fade back a touch for depth. Cards are
   * clickable, so the peeks get a pointer cursor + a small hover lift.
   */
  .card {
    flex: 0 0 auto;
    height: clamp(360px, 56vh, 540px);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    display: grid;
    place-items: center;
    cursor: pointer;
    opacity: 1;
    transform: scale(0.88);
    transform-origin: center bottom;
    transition:
      opacity 0.45s var(--ease-paper),
      transform 0.45s var(--ease-paper);
  }
  .card:focus-visible {
    outline: 2px solid var(--color-copper);
    outline-offset: 6px;
    border-radius: 12px;
  }
  .strip[data-js-active] .card:not(.is-focus) {
    opacity: 0.5;
  }
  .strip[data-js-active] .card:not(.is-focus):hover {
    opacity: 0.78;
    transform: scale(0.91);
  }
  .strip[data-js-active] .card.is-focus {
    transform: scale(1);
    cursor: default;
  }
  .strip:not([data-js-active]) .card {
    opacity: 1;
    transform: none;
  }
  .card :global(img) {
    display: block;
    height: 100%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 26px 34px rgba(42, 53, 37, 0.3));
    pointer-events: none;
  }

  /* Dot indicators — replace the scrollbar */
  .dots {
    display: flex;
    justify-content: center;
    gap: 0.625rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dots li { display: block; }
  .dot {
    appearance: none;
    border: none;
    padding: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(63, 79, 48, 0.22);
    cursor: pointer;
    transition:
      background 0.25s var(--ease-paper),
      transform 0.25s var(--ease-paper),
      width 0.25s var(--ease-paper);
  }
  .dot:hover { background: rgba(63, 79, 48, 0.4); }
  .dot:focus-visible {
    outline: 2px solid var(--color-copper);
    outline-offset: 3px;
  }
  .dot.is-focus {
    background: var(--color-copper);
    width: 22px;
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .strip { scroll-behavior: auto; }
    .card { transition: none; transform: none; }
    .dot { transition: none; }
    .strip[data-js-active] .card:not(.is-focus) { opacity: 1; }
    .strip[data-js-active] .card.is-focus { transform: none; }
  }
</style>
