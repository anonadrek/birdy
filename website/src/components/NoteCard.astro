---
import { Image } from 'astro:assets';
import Kicker from './ui/Kicker.astro';
import { fieldNoteHref, formatNoteDate, readingMinutes, type FieldNote } from '../lib/field-notes';
import { getCopy } from '../lib/i18n';

interface Props {
  note: FieldNote;
  /** large = picture beside the text (the newest note on the blog); small = picture above the text (the grids). */
  size?: 'large' | 'small';
  headingLevel?: 'h2' | 'h3';
  /** The card's image loads eager + high fetchpriority (likely LCP). Default: lazy, like every other card. */
  priority?: boolean;
  /** How wide the card is drawn, for the browser's choice of image file; the default fits the blog's grid. */
  sizes?: string;
}
const { note, size = 'small', headingLevel = 'h3', priority = false, sizes: sizesProp } = Astro.props;
const { locale, title, description, category, date, image, imageAlt, imagePosition } = note.data;
const t = getCopy(locale);
const Heading = headingLevel;
const minutes = t.blog.minRead.replace('{n}', String(readingMinutes(note.body)));
// The card's whole surface is the link; without this its accessible name is every descendant's
// text (kicker + title + description + meta, 256+ characters). Point it at the title alone instead.
const titleId = `nc-title-${note.id.replace(/[^a-zA-Z0-9_-]+/g, '-')}`;
---

<a class:list={['ncard', `ncard--${size}`]} href={fieldNoteHref(note)} aria-labelledby={titleId}>
  <div class="ncard-img">
    <Image
      src={image}
      alt={imageAlt}
      widths={size === 'large' ? [700, 1000, 1400] : [480, 720, 1000]}
      sizes={sizesProp ?? (size === 'large' ? '(max-width: 1100px) 100vw, 620px' : '(max-width: 760px) 100vw, 540px')}
      style={imagePosition ? `object-position:${imagePosition}` : undefined}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  </div>
  <div class="ncard-body">
    <Kicker text={category} />
    <Heading class="ncard-title" id={titleId}>{title}</Heading>
    {size === 'large' && <p class="ncard-desc">{description}</p>}
    <p class="ncard-meta"><time datetime={date.toISOString().slice(0, 10)}>{formatNoteDate(date, locale)}</time> · <span class="nw">{minutes}</span></p>
  </div>
</a>

<style>
  /* One system for every card (2026-10-10): the picture whole at the notes' own 1600 × 840, the words below it from the
     top, the meta line at the foot, so cards side by side line up at their titles and at their metas. */
  .ncard { display: grid; grid-template-rows: auto 1fr; background: var(--card); border-radius: 18px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); transition: transform .35s var(--ease-paper), box-shadow .35s var(--ease-paper); }
  .ncard:hover { transform: translateY(-3px); box-shadow: 0 0 0 1px var(--line), 0 18px 36px rgba(var(--dark-rgb), .12); }
  .ncard-img { position: relative; overflow: hidden; aspect-ratio: 1600 / 840; background: var(--peach); }
  .ncard-img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; transition: transform .6s var(--ease-paper); }
  @media (hover: hover) and (pointer: fine) {
    .ncard:hover .ncard-img :global(img) { transform: scale(1.035); }
    .ncard:hover .ncard-title { color: var(--rust); }
  }
  @media (prefers-reduced-motion: reduce) { .ncard-img :global(img) { transition: none; } }
  .ncard-body { display: flex; flex-direction: column; align-items: flex-start; padding: 20px 22px 22px; }
  .ncard-body :global(.kick) { margin-bottom: 10px; font-size: 10px; }
  .ncard-title { font-size: 22px; line-height: 1.12; overflow-wrap: anywhere; hyphens: auto; text-wrap: balance; transition: color .25s; }
  .ncard-desc { color: var(--muted); font-size: 15px; line-height: 1.6; margin: 14px 0 0; }
  .ncard-meta { margin: auto 0 0; padding-top: 16px; font-size: 11.5px; color: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
  .nw { white-space: nowrap; }
  /* Side by side only where the picture's column is wide enough to show it (nearly) whole; stacked below that. */
  .ncard--large { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); grid-template-rows: none; }
  .ncard--large .ncard-img { align-self: stretch; }
  .ncard--large .ncard-body { justify-content: center; padding: 36px 38px; }
  .ncard--large .ncard-body :global(.kick) { margin-bottom: 12px; font-size: 11px; }
  .ncard--large .ncard-title { font-size: 34px; line-height: 1.05; }
  .ncard--large .ncard-meta { margin-top: 0; padding-top: 22px; }
  @media (max-width: 1100px) {
    .ncard--large { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
    .ncard--large .ncard-body { padding: 26px 28px 28px; }
  }
  @media (max-width: 760px) {
    .ncard--large .ncard-body { padding: 22px 22px 24px; }
    .ncard--large .ncard-title { font-size: 28px; }
  }
</style>
