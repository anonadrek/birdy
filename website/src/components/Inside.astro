---
import EyebrowLabel from './ui/EyebrowLabel.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import OrnamentRule from './ui/OrnamentRule.astro';
import { type Locale, getCopy } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale);
---

<section id="inside" class="inside">
  <div class="head" data-reveal>
    <EyebrowLabel text={t.inside.eyebrow} plate="V" />
    <JournalHeadline text={t.inside.headline} level="h2" />
    <p class="sub">{t.inside.sub}</p>
    <OrnamentRule />
  </div>

  <ul class="stats" role="list">
    {t.inside.stats.map((stat, i) => (
      <li class="stat" data-reveal data-stat style={`--rd:${i * 120}ms`}>
        <span class="sr-only">{stat.value}</span>
        <span class="value" data-count={stat.value} aria-hidden="true">{stat.value}</span>
        <span class="label">{stat.label}</span>
        <span class="caption">{stat.caption}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .inside {
    padding: var(--section-padding-y) 1.5rem;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .head { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .sub {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-marginalia-ink);
    margin: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 3.5rem auto 0;
    max-width: 68rem;
    list-style: none;
    padding: 0;
  }
  .stat {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.2rem 2rem;
  }
  .stat::after { content: ''; display: block; width: 2.5rem; height: 2px; margin-top: .8rem; background: var(--color-orange); }
  .stat.is-visible::after { animation: rule-arrive .7s .35s var(--ease-paper) both; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @keyframes rule-arrive { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  /* Hairline dividers between the columns — ruled like a journal index page */
  .stat + .stat {
    border-left: 1px solid var(--color-paper-edge);
  }
  .value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(3.8rem, 7vw, 6rem);
    color: var(--color-orange);
    line-height: 1;
  }
  .label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    color: var(--color-text-primary);
    margin-top: 0.25rem;
  }
  .caption {
    font-family: var(--font-script);
    font-size: 1.25rem;
    color: var(--color-marginalia-ink);
    margin-top: 0.5rem;
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; gap: 2rem; }
    .stat + .stat {
      border-left: none;
      border-top: 1px solid var(--color-paper-edge);
      padding-top: 2rem;
    }
  }
</style>

<script>
  const stats = document.querySelectorAll<HTMLElement>('[data-stat]');
  if (stats.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const counterObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        counterObserver.unobserve(entry.target);
        const value = entry.target.querySelector<HTMLElement>('[data-count]');
        const target = Number(value?.dataset.count);
        if (!value || !Number.isFinite(target) || target === 0) continue;
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min(1, (now - start) / duration);
          value.textContent = String(Math.round(target * (1 - Math.pow(1 - progress, 3))));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    }, { threshold: 0.45 });
    stats.forEach((stat) => counterObserver.observe(stat));
  }
</script>
