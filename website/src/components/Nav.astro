---
import Wordmark from './ui/Wordmark.astro';
import Icon from './ui/Icon.astro';
import { type Locale, getCopy } from '../lib/i18n';
import { fieldNotesHref } from '../lib/field-notes';
import { hasSpecies as anySpecies, hubHref } from '../lib/species';
import { premiumHref } from '../lib/links';

interface Props {
  locale: Locale;
  switchLangHref?: string;
  /** overlay = transparent over the first view until it scrolls past; solid = paper bar in the flow. */
  variant?: 'overlay' | 'solid';
  /** What the transparent overlay bar lies on: 'dark' (espresso heroes and photos: cream text, apricot wordmark) or
   * 'peach' (the home page's peach hero, spec 2026-10-09: ink text, rust wordmark). The solid bar is paper with ink
   * text and the rust wordmark either way (Albin 2026-10-10: the site's light theme, no brown bar). */
  surface?: 'dark' | 'peach';
}
const { locale, switchLangHref, variant = 'solid', surface = 'dark' } = Astro.props;
const t = getCopy(locale);
const home = locale === 'sv' ? '/sv/' : '/';
const langHref = switchLangHref ?? t.nav.switchLangHref;
const langAttr = locale === 'sv' ? 'en' : 'sv';
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// "Species" only once there is something to show (Task 7's review): before the first species is published
// the hub only says the pages are on their way, so the menu looks as it did before.
const speciesHub = hubHref(locale);
const hasSpecies = await anySpecies();
const links = [
  ...(hasSpecies ? [{ href: speciesHub, label: t.nav.species }] : []),
  { href: `${home}#how-it-works`, label: t.nav.howItWorks },
  { href: `${home}#app`, label: t.nav.app },
  { href: premiumHref(locale), label: t.nav.premium },
  { href: fieldNotesHref(locale), label: t.nav.fieldNotes },
];
// "Species" is current on the hub, group, species, comparison and about pages.
const isCurrent = (href: string) => href === here || (hasSpecies && href === speciesHub && here.startsWith(speciesHub));
const mobileOnly = [
  { href: `${home}#guide`, label: t.nav.guide },
  { href: `${home}#privacy`, label: t.nav.privacy },
  { href: `${home}#faq`, label: t.nav.faq },
];
---

<nav id="site-nav" class:list={['nav', `nav--${variant}`, { 'nav--peach': surface === 'peach' }]} aria-label={t.nav.label} data-variant={variant}>
  <div class="nav-inner">
    <a href={home} class="brand" aria-label="Birdy"><Wordmark size="32px" alt={t.alt.wordmark} color="var(--nav-brand)" /></a>
    <div class="links">
      {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="lang" href={langHref} lang={langAttr}>{t.nav.switchLang}</a>
    </div>
    <a class="btn nav-cta" href={`${home}#download`}>{t.nav.getApp}</a>
    <button class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label={t.nav.menuOpen} data-label-open={t.nav.menuOpen} data-label-close={t.nav.menuClose}>
      <Icon name="menu" size={24} />
    </button>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    {[...links, ...mobileOnly].map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a href={langHref} lang={langAttr}>{t.nav.switchLang}</a>
    <a class="btn" href={`${home}#download`}>{t.nav.getApp}</a>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  // The browser bar (theme-color) follows the bar: the page's own colour (Layout's themeColor) while the overlay bar is
  // transparent over the hero, paper (--paper) while the bar is solid or the menu is open.
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const heroTheme = themeMeta?.content ?? '';
  const paperTheme = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim();
  const syncTheme = () => {
    if (!nav || !themeMeta || !paperTheme) return;
    const light = nav.dataset.variant !== 'overlay' || nav.classList.contains('is-solid') || nav.classList.contains('is-open');
    themeMeta.content = light ? paperTheme : heroTheme;
  };
  const setOpen = (open: boolean) => {
    if (!nav || !toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    menu.hidden = !open;
    nav.classList.toggle('is-open', open);
    syncTheme();
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Esc closes an open menu and gives focus back to the toggle if it was inside the menu.
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu || menu.hidden) return;
    const inside = menu.contains(document.activeElement);
    setOpen(false);
    if (inside) toggle?.focus();
  });
  // Tabbing out of the nav closes the menu. Pointer taps (relatedTarget null) are ignored, so a tap on a menu link is never lost.
  nav?.addEventListener('focusout', (e) => {
    const next = e.relatedTarget;
    if (menu && !menu.hidden && next instanceof Node && !nav.contains(next)) setOpen(false);
  });
  // Leaving the mobile layout closes the menu (same breakpoint as the CSS).
  matchMedia('(max-width: 1023px)').addEventListener('change', (e) => { if (!e.matches) setOpen(false); });

  // Overlay variant: transparent over the first view ([data-nav-until]), paper once it has scrolled past.
  if (nav?.dataset.variant === 'overlay') {
    const until = document.querySelector<HTMLElement>('[data-nav-until]');
    if (!until || !('IntersectionObserver' in window)) {
      nav.classList.add('is-solid');
      syncTheme();
    } else {
      new IntersectionObserver((entries) => {
        nav.classList.toggle('is-solid', !entries[entries.length - 1].isIntersecting);
        syncTheme();
      }, {
        rootMargin: `-${nav.offsetHeight}px 0px 0px 0px`,
      }).observe(until);
    }
  }
</script>

<style>
  /* The bar is the site's light paper with ink text (Albin 2026-10-10: no brown bar). The wordmark is the orange of the
     handwritten accent words, --nav-brand: rust on the light bar and the peach hero, apricot on the dark first views. */
  .nav { z-index: 100; color: var(--ink); --nav-brand: var(--rust); font-size: 13px; font-weight: 600; transition: background-color .3s var(--ease-paper), box-shadow .3s var(--ease-paper), color .3s var(--ease-paper); }
  .nav--overlay { position: fixed; top: 0; left: 0; right: 0; }
  .nav--solid { position: sticky; top: 0; }
  /* Paper by default, also without JavaScript. The overlay bar turns transparent only when scripts run (html.js, set in Layout). */
  .nav--solid, .nav--overlay, .nav.is-solid, .nav.is-open { background: var(--paper); box-shadow: 0 1px 0 rgba(var(--dark-rgb), .12); }
  /* Transparent over a dark first view (the Premium page's hero, a field note's photo): cream text, apricot wordmark,
     apricot focus rings. */
  :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) { background: transparent; box-shadow: none; color: var(--cream); --nav-brand: var(--apricot); }
  :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) :global(:focus-visible) { outline-color: var(--apricot); }
  /* The home page's peach hero (surface="peach", spec 2026-10-09): ink on the transparent bar, the rust wordmark, rust
     focus rings, and below 1024 px no espresso disc behind the menu button and no shadow under the wordmark. The solid
     bar (scrolled past, menu open, no JavaScript) is paper. */
  :global(html.js) .nav--overlay.nav--peach:not(.is-solid):not(.is-open) { color: var(--ink); --nav-brand: var(--rust); }
  :global(html.js) .nav--overlay.nav--peach:not(.is-solid):not(.is-open) :global(:focus-visible) { outline-color: var(--rust); }
  @media (max-width: 1023px) {
    :global(html.js) .nav--overlay.nav--peach:not(.is-solid):not(.is-open) .menu-toggle { background: none; }
    :global(html.js) .nav--overlay.nav--peach:not(.is-solid):not(.is-open) .brand { filter: none; }
  }
  /* Below 1024 px the photo band scrolls under the transparent bar. The menu button gets its own espresso
     disc (icon contrast at least 3:1 over any part of the photo) and the wordmark a soft shadow, so the
     bar itself stays transparent as in the mockup. */
  @media (max-width: 1023px) {
    :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) .menu-toggle { background: rgba(var(--dark-rgb), .6); border-radius: 50%; }
    :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) .brand { filter: drop-shadow(0 1px 3px rgba(0, 0, 0, .45)); }
  }
  .nav.is-open { transition: none; }
  .nav :global(:focus-visible) { outline-color: var(--rust); }
  .nav-inner { max-width: 1320px; margin: 0 auto; height: 76px; display: flex; align-items: center; gap: 26px; padding: 0 44px; }
  .brand { margin-right: auto; display: inline-flex; }
  .links { display: flex; align-items: center; gap: 26px; }
  .links a { opacity: .82; transition: opacity .2s; }
  /* From 1024 px up, while the bar is still transparent over the photo, the links need a touch more
     opacity than the default .82 to clear 4.5:1; hover must still win, so it gets its own override too. */
  :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) .links a { opacity: .9; }
  .links a:hover { opacity: 1; }
  :global(html.js) .nav--overlay:not(.is-solid):not(.is-open) .links a:hover { opacity: 1; }
  .menu-toggle { display: none; background: none; border: 0; color: inherit; width: 44px; height: 44px; align-items: center; justify-content: center; cursor: pointer; transition: background-color .3s var(--ease-paper); }
  .mobile-menu { display: none; padding: 4px 20px 20px; max-height: calc(100vh - 64px); max-height: calc(100dvh - 64px); overflow-y: auto; overscroll-behavior: contain; }
  .mobile-menu a { padding: 14px 0; border-bottom: 1px solid rgba(var(--dark-rgb), .12); font-size: 15px; }
  .mobile-menu .btn { margin-top: 16px; justify-content: center; border-bottom: 0; }
  .mobile-menu a:focus-visible { outline-offset: -3px; }
  @media (max-width: 1023px) {
    .links, .nav-cta { display: none; }
    .menu-toggle { display: inline-flex; }
    .nav-inner { height: 64px; padding: 0 20px; }
    .mobile-menu:not([hidden]) { display: grid; }
  }
  /* Without JavaScript the toggle can't open anything; the footer carries every link. */
  :global(html:not(.js)) .menu-toggle { display: none; }
</style>
