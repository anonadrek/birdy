---
// The Birdy × AlbIT hero (the field note birdy-x-albit, 2026-10-10): AlbIT's black field meets Birdy's peach paper at
// a torn edge, and Birdy's flock flies across the seam, gold on AlbIT's side, Birdy's own colours on the paper, where
// the birds form Birdy's bird. Two art-directed SVGs from src/lib/collab-hero.mjs: wide (seam vertical) and tall (seam
// horizontal, under 761 px). The pictures are decorative; the container carries the description.
import { getImage } from 'astro:assets';
import albitWordmark from '../assets/brand/albit-wordmark-white.png';
import { collabDefs, collabArt } from '../lib/collab-hero.mjs';

interface Props { label: string }
const { label } = Astro.props;
// Twice the largest drawn width, so the wordmark stays sharp on 2x screens.
const mark = await getImage({ src: albitWordmark, width: 900, format: 'webp', quality: 90 });
const defs = collabDefs();
const wide = collabArt('wide', mark.src);
const tall = collabArt('tall', mark.src);
---

<div class="bxa" role="img" aria-label={label} data-collab-hero>
  <Fragment set:html={defs} />
  <Fragment set:html={wide} />
  <Fragment set:html={tall} />
</div>

<style>
  .bxa { position: relative; width: 100%; aspect-ratio: 1600 / 840; max-height: min(64vh, 700px); min-height: 380px; overflow: hidden; background: #111111; }
  .bxa :global(.bxa-defs) { position: absolute; width: 0; height: 0; overflow: hidden; }
  .bxa :global(.bxa-art) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .bxa :global(.bxa-tall) { display: none; }
  .bxa :global(.bxa-word) { font-family: var(--font-script); font-weight: 700; }
  /* The stream drifts in once on load, from a visible start (a thumbnail or the first frame still shows it). */
  .bxa :global(.bxa-stream) { animation: bxa-in 1.6s var(--ease-paper) both; }
  @keyframes bxa-in { from { transform: translate(-26px, 6px); opacity: .5; } to { transform: none; opacity: 1; } }
  @media (max-width: 760px) {
    .bxa { aspect-ratio: 800 / 1100; max-height: none; min-height: 0; }
    .bxa :global(.bxa-wide) { display: none; }
    .bxa :global(.bxa-tall) { display: block; }
  }
  @media (prefers-reduced-motion: reduce) { .bxa :global(.bxa-stream) { animation: none; } }
  @media (forced-colors: active) { .bxa :global(.bxa-art) { forced-color-adjust: none; } }
</style>
