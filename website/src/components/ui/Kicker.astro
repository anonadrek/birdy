---
// The small uppercase line with a hairline before it (and after it when centered).
// Colour comes from --kick-color on an ancestor (rust by default, apricot on espresso).
interface Props {
  text: string;
  center?: boolean;
  class?: string;
  /** "la" when the text is a Latin name (the family kicker on an English species page). */
  lang?: string;
}
const { text, center = false, class: cls, ...rest } = Astro.props;
---

<p class:list={['kick', { 'kick--center': center }, cls]} {...rest}><span class="kick-line" aria-hidden="true"></span>{text}{center && <span class="kick-line" aria-hidden="true"></span>}</p>
