---
interface Props {
  text: string;
  color?: string;
  /** Roman plate number ("II", "V") — sections as numbered plates, the same
      vocabulary as the app's PlateFrame captions. */
  plate?: string;
}
const { text, color = 'var(--rust)' } = Astro.props;
---

<div class="eyebrow" style={`--c:${color}`}>
  {text}
</div>

<style>
  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--c);
    font-weight: 600;
  }
</style>
