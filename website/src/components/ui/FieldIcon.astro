---
type IconName = 'scan' | 'match' | 'journal' | 'browse' | 'pdf' | 'chart' | 'stamp';

interface Props {
  name: IconName;
  size?: string;
}

const { name, size = '26px' } = Astro.props;
---

<svg class="field-icon" style={`--icon-size:${size}`} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'scan' && <>
    <path d="M11 5H7a2 2 0 0 0-2 2v4m16-6h4a2 2 0 0 1 2 2v4M5 21v4a2 2 0 0 0 2 2h4m16-6v4a2 2 0 0 1-2 2h-4" />
    <path d="M9 20c3-7 8-10 15-8-2 6-7 10-15 8Zm5-2 7-4" />
  </>}
  {name === 'match' && <>
    <path d="m16 3 2.4 8.6L27 14l-8.6 2.4L16 25l-2.4-8.6L5 14l8.6-2.4L16 3Z" />
    <path d="m25 23 .8 2.2L28 26l-2.2.8L25 29l-.8-2.2L22 26l2.2-.8L25 23Z" />
  </>}
  {name === 'journal' && <>
    <path d="M6 5.5h8.5c1.6 0 2.7.6 3.5 1.7.8-1.1 1.9-1.7 3.5-1.7H26v20h-4.5c-1.6 0-2.7.6-3.5 1.7-.8-1.1-1.9-1.7-3.5-1.7H6v-20Z" />
    <path d="M18 7.2v20M9 11h5m-5 4h5m7-4h2" />
  </>}
  {name === 'browse' && <>
    <circle cx="13.8" cy="13.8" r="8.3" />
    <path d="m20 20 6.8 6.8M11 17.5c1.4-3.2 3.4-4.7 6.6-4.9-.7 3-2.8 4.5-6.6 4.9Z" />
  </>}
  {name === 'pdf' && <>
    <path d="M8 3.5h11l5 5v20H8v-25Zm11 0v5h5M12 14h8m-8 4h8m-8 4h5" />
  </>}
  {name === 'chart' && <>
    <path d="M5 26V7m0 19h22M9 20l5-6 4 3 7-10" />
    <circle cx="9" cy="20" r="1" /><circle cx="14" cy="14" r="1" /><circle cx="18" cy="17" r="1" /><circle cx="25" cy="7" r="1" />
  </>}
  {name === 'stamp' && <>
    <circle cx="16" cy="16" r="11" /><circle cx="16" cy="16" r="8" />
    <path d="m16 9 1.9 4.7 5.1.4-3.9 3.3 1.2 5-4.3-2.7-4.3 2.7 1.2-5L9 14.1l5.1-.4L16 9Z" />
  </>}
</svg>

<style>
  .field-icon { display: block; width: var(--icon-size); height: var(--icon-size); flex: none; }
</style>
