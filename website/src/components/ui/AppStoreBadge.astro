---
import { type Locale, getCopy } from '../../lib/i18n';

// Store-style App Store badge rendered inline (no official asset while the
// iOS app is unreleased). Deliberately NOT a link: iOS is in development, so
// the badge is dimmed, non-interactive, and annotated with a handwritten
// "soon!" in the journal voice.
interface Props {
  locale: Locale;
  size?: 'small' | 'large';
  class?: string;
}
const { locale, size = 'large', class: cls = '' } = Astro.props;
const t = getCopy(locale);
const w = size === 'large' ? 190 : 140;
const h = size === 'large' ? 68 : 50;
---

<span class={`appstore ${cls}`} role="img" aria-label={t.alt.appStoreBadge} title={t.alt.appStoreBadge} aria-disabled="true">
  <svg
    class="plate"
    width={w}
    height={h}
    viewBox="0 0 190 68"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect x="0.5" y="0.5" width="189" height="67" rx="10" fill="#1a1612" stroke="#a6a6a6" stroke-opacity="0.55" />
    <g transform="translate(17 16) scale(1.5)">
      <path
        fill="#F0EAD8"
        d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702"
      />
    </g>
    <text x="62" y="28" fill="#F0EAD8" font-family="Inter, system-ui, sans-serif" font-size="11" letter-spacing="0.02em">{t.appStoreBadge.top}</text>
    <text x="62" y="50" fill="#F0EAD8" font-family="Inter, system-ui, sans-serif" font-size="21" font-weight="600" letter-spacing="0.01em">{t.appStoreBadge.bottom}</text>
  </svg>
  <span class="note" aria-hidden="true">{t.appStoreBadge.note}</span>
</span>

<style>
  .appstore {
    position: relative;
    display: inline-block;
    line-height: 0;
    cursor: default;
    user-select: none;
  }
  .plate {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.58;
    filter: saturate(0.85);
  }
  .note {
    position: absolute;
    top: -0.9em;
    right: -0.9em;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-copper);
    transform: rotate(6deg);
  }
</style>
