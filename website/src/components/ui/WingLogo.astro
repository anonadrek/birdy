---
interface Props {
  variant?: 'paper' | 'transparent';
  size?: string;
  alt: string;
  class?: string;
}
// Both wing-logo SVG assets turned out to be the full wordmark, so the bird
// mark comes from the transparent app-icon raster instead (192px source —
// crisp at every size this component is used at).
const { size = '48px', alt, class: cls = '' } = Astro.props;
const src = '/favicon-192.png';
---

<img
  src={src}
  alt={alt}
  width={size.replace('px', '')}
  height={size.replace('px', '')}
  style={`width:${size};height:${size}`}
  class={cls}
  loading="lazy"
  decoding="async"
/>
