---
import EyebrowLabel from './ui/EyebrowLabel.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import FieldIcon from './ui/FieldIcon.astro';
import { type Locale, getCopy } from '../lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getCopy(locale);
---

<section id="premium" class="premium">
  <div class="inner">
    <div class="copy" data-reveal>
      <EyebrowLabel text={t.premium.eyebrow} />
      <JournalHeadline text={t.premium.headline} level="h2" align="left" size="clamp(3rem,5vw,4.7rem)" />
      <p class="lead">{t.premium.sub}</p>
      <p class="body">{t.premium.body}</p>
    </div>
    <div class="features">
      <p class="feature-heading">{locale === 'sv' ? 'När du vill gå längre' : 'When you want to go further'}</p>
      <div data-reveal="slide"><span class="feature-icon"><FieldIcon name="pdf" /></span><p>{locale === 'sv' ? 'Exportera din dagbok som PDF' : 'Export your journal as a PDF'}</p></div>
      <div data-reveal="slide" style="--rd:90ms"><span class="feature-icon"><FieldIcon name="chart" /></span><p>{locale === 'sv' ? 'Se din säsong i statistik' : 'See your season in statistics'}</p></div>
      <div data-reveal="slide" style="--rd:180ms"><span class="feature-icon"><FieldIcon name="stamp" /></span><p>{locale === 'sv' ? 'Samla extra fältmärken' : 'Collect extra field stamps'}</p></div>
    </div>
  </div>
</section>

<style>
  .premium { padding: var(--section-padding-y) clamp(1.5rem,6vw,5rem); }
  .inner { max-width: 1190px; margin: auto; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem,8vw,8rem); align-items: center; }
  .copy :global(.journal-headline) { margin-top: 1rem; }
  .lead { font: 1.7rem var(--font-script); color: var(--color-orange); margin: 1.2rem 0 .7rem; }
  .body { max-width: 34rem; line-height: 1.7; color: var(--color-marginalia-ink); }
  .features { border-top: 1px solid var(--color-paper-edge); }
  .feature-heading { margin: 0; padding: 1rem 0; color: var(--color-orange); font-size: .83rem; font-weight: 600; }
  .features div { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; align-items: center; border-top: 1px solid var(--color-paper-edge); min-height: 86px; }
  .feature-icon { width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 50%; background: #fce4c9; border: 1px solid #edc29d; color: var(--color-orange); }
  .features div p { font: 1.25rem var(--font-serif); margin: 0; }
  @media (max-width: 780px) { .inner { grid-template-columns: 1fr; gap: 2rem; } }
</style>
