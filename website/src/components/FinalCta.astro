---
import PlayStoreBadge from './ui/PlayStoreBadge.astro';
import AppStoreBadge from './ui/AppStoreBadge.astro';
import { type Locale, getCopy } from '../lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getCopy(locale);
const playUrl = 'https://play.google.com/store/apps/details?id=se.birdy.android';
---

<section id="download" class="final-cta">
  <div class="inner" data-reveal>
    <div class="topline"><span>{locale === 'sv' ? 'Birdy för Android' : 'Birdy for Android'}</span><span>Birdy · 2026</span></div>
    <p class="statement">{t.hero.headline}<br />{t.hero.line2}</p>
    <h2>{locale === 'sv' ? 'Ta med Birdy ut i fält.' : 'Take Birdy into the field.'}</h2>
    <div class="bottom-row">
      <p class="sub">{locale === 'sv' ? 'En fågelguide för det du ser. En dagbok för det du vill minnas.' : 'A guide for what you see. A journal for what you want to remember.'}</p>
      <div class="download-actions">
        <div class="cta">
          <PlayStoreBadge locale={locale} href={playUrl} alt={t.alt.playStoreBadge} size="large" />
          <AppStoreBadge locale={locale} size="large" />
        </div>
        <p class="small">{locale === 'sv' ? 'Gratis att börja · Inget konto krävs · Fungerar offline' : 'Free to start · No account needed · Works offline'}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta { padding: clamp(4rem,7vw,7rem) clamp(1.5rem,6vw,5rem); background: #f8d3a8; color: var(--color-rust-shadow); }
  .inner { max-width: 1260px; margin: auto; }
  .topline { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(63,30,24,.35); padding-top: .9rem; font-size: .75rem; font-weight: 600; color: var(--color-rust-deep); }
  .statement { font: 600 clamp(1.3rem,2.2vw,2rem)/1.15 var(--font-sans); letter-spacing: -.035em; margin: clamp(3rem,6vw,6rem) 0 1.5rem; }
  h2 { margin: 0; font-size: clamp(4rem,10vw,10rem); line-height: .9; letter-spacing: -.055em; max-width: 12ch; text-wrap: balance; }
  .bottom-row { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-top: clamp(2.5rem,5vw,5rem); padding-top: 1.5rem; border-top: 1px solid rgba(63,30,24,.35); }
  .sub { margin: 0; font: 400 clamp(1.4rem,2.3vw,2rem)/1.3 var(--font-serif); max-width: 19ch; }
  .download-actions { flex-shrink: 0; }
  .cta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .small { margin: 1rem 0 0; color: var(--color-rust-deep); font-size: .76rem; }
  @media (max-width: 800px) { .bottom-row { flex-direction: column; align-items: start; gap: 2rem; } .download-actions { flex-shrink: 1; } h2 { font-size: clamp(3.7rem,12vw,7rem); } }
</style>
