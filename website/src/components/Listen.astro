---
import { Image } from 'astro:assets';
import EyebrowLabel from './ui/EyebrowLabel.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import { type Locale, getCopy } from '../lib/i18n';
import cardEnListen from '../assets/screens/card_en_listen.png';
import cardSvListen from '../assets/screens/card_sv_listen.png';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getCopy(locale);
const shot = locale === 'sv' ? cardSvListen : cardEnListen;
---

<section id="listen" class="listen">
  <div class="grid">
    <div class="visual">
      <div class="halo"></div>
      <Image src={shot} alt={t.alt.listenScreen} widths={[360,560,760]} sizes="(max-width: 800px) 70vw, 360px" loading="lazy" decoding="async" />
    </div>
    <div class="text">
      <EyebrowLabel text={t.listen.eyebrow} />
      <JournalHeadline text={t.listen.headline} level="h2" align="left" size="clamp(2.8rem,5vw,4.7rem)" />
      <p class="sub">{t.listen.sub}</p>
      <p class="body">{t.listen.body}</p>
      <span class="note">✳ {locale === 'sv' ? 'Ljudidentifiering ingår gratis.' : 'Sound identification is free.'}</span>
    </div>
  </div>
</section>

<style>
  .listen { background: #e2e8dc; padding: clamp(4rem,7vw,7rem) clamp(1.5rem,6vw,5rem); overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(2rem,6vw,7rem); max-width: 1260px; margin: auto; }
  .visual { position: relative; display: grid; place-items: center; min-height: 530px; }
  .halo { position: absolute; width: min(480px,100%); aspect-ratio: 1; border: 1px solid #aec2aa; border-radius: 50%; box-shadow: 0 0 0 55px rgba(174,194,170,.15), 0 0 0 110px rgba(174,194,170,.1); }
  .visual :global(img) { position: relative; width: min(360px,78%); height: auto; filter: drop-shadow(0 32px 24px rgba(18,43,30,.22)); transform: rotate(-3deg); }
  .text { position: relative; }
  .text :global(.journal-headline) { margin-top: 1rem; }
  .sub { font: 1.65rem/1.2 var(--font-script); color: var(--color-copper); margin: 1.3rem 0 1rem; }
  .body { max-width: 33rem; line-height: 1.7; color: var(--color-marginalia-ink); font-size: 1.02rem; }
  .note { display: inline-block; border-top: 1px solid #aac0aa; margin-top: 1.2rem; padding-top: 1rem; color: var(--color-moss-deep); font-size: .82rem; font-weight: 600; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .visual { order: 2; min-height: 430px; } .text { order: 1; } .visual :global(img) { max-width: 280px; } }
</style>
