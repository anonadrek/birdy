---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Kicker from './ui/Kicker.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import PlayStoreBadge from './ui/PlayStoreBadge.astro';
import BuiltSpeciesLinks from './ui/BuiltSpeciesLinks.astro';
import CollabHero from './CollabHero.astro';
import NoteCard from './NoteCard.astro';
import { fieldNoteHref, fieldNotesHref, formatNoteDate, getFieldNotes, readingMinutes, type FieldNote } from '../lib/field-notes';
import { getCopy } from '../lib/i18n';
import { albitProductHref, ALBIT_URL, ALBIN_URL } from '../lib/links';
import albitWordmark from '../assets/brand/albit-wordmark-white.png';
import '../styles/article-prose.css';

interface Props { note: FieldNote }
const { note } = Astro.props;
const { Content } = await render(note);
const { locale, title, description, date, category, image, imageAlt, imageCaption, imagePosition, updated, collab } = note.data;
const t = getCopy(locale);
const sv = locale === 'sv';
const pathname = fieldNoteHref(note);
const otherPath = `${sv ? '' : '/sv'}/blog/${note.data.slug}/`;
const home = sv ? '/sv/' : '/';
const minutes = t.blog.minRead.replace('{n}', String(readingMinutes(note.body)));
// The note's own photo, cropped to 1200×630, is the share image (spec §6).
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const playUrl = 'https://play.google.com/store/apps/details?id=se.birdy.android';
// A rewritten note says so next to its date (2026-10-10).
const updatedLabel = updated ? t.blog.updated.replace('{date}', formatNoteDate(updated, locale)) : null;
// The collab title: the × between the two brands in AlbIT's gold, the rest as written.
// Two more notes to read next, newest first (the list's own order).
const more = (await getFieldNotes(locale)).filter((n) => n.data.slug !== note.data.slug).slice(0, 2);
const [titleBefore, titleAfter] = title.includes('×') ? [title.slice(0, title.indexOf('×')), title.slice(title.indexOf('×') + 1)] : [title, null];
---

<Layout locale={locale} pathname={pathname} title={`${title} | Birdy`} description={description} articleDate={date.toISOString()} articleModified={updated?.toISOString()} ogImage={share.src} ogImageAlt={imageAlt}>
  <Nav locale={locale} variant="solid" switchLangHref={otherPath} />
  <div class="aprog" aria-hidden="true"><span data-read-progress></span></div>
  <main id="main" tabindex="-1">
    {collab ? (
    <header class="chead">
      <CollabHero label={t.blog.collabArt} />
      <div class="ctitle">
        <Kicker text={category} center />
        <h1 class="ch1">{titleAfter === null ? title : <>{titleBefore}<span class="ch1-x">×</span>{titleAfter}</>}</h1>
        <p class="aby"><a href={albitProductHref(locale)}>{t.blog.byline}</a></p>
        <p class="ameta"><time datetime={date.toISOString().slice(0, 10)}>{formatNoteDate(date, locale)}</time> · {minutes}{updatedLabel && <> · {updatedLabel}</>}</p>
      </div>
    </header>
    ) : (
    <header class="phead">
      <figure class="wrap pfig">
        <div class="aplate">
          <Image src={image} alt={imageAlt} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1048px) calc(100vw - 88px), 960px" style={imagePosition ? `object-position:${imagePosition}` : undefined} loading="eager" fetchpriority="high" decoding="async" />
        </div>
        {imageCaption && <figcaption class="cap">{imageCaption}</figcaption>}
      </figure>
      <div class="ctitle">
        <Kicker text={category} center />
        <h1 class="ch1">{title}</h1>
        <p class="aby"><a href={albitProductHref(locale)}>{t.blog.byline}</a></p>
        <p class="ameta"><time datetime={date.toISOString().slice(0, 10)}>{formatNoteDate(date, locale)}</time> · {minutes}{updatedLabel && <> · {updatedLabel}</>}</p>
      </div>
    </header>
    )}
    <article class="asheet">
      <div class="article-prose"><BuiltSpeciesLinks><Content /></BuiltSpeciesLinks></div>
      {!collab && (
      <aside class="aauthor" aria-label={t.blog.authorKicker}>
        <p class="aauthor-k">{t.blog.authorKicker}</p>
        <p class="aauthor-n">Albin Abrahamsson</p>
        <p class="aauthor-b">{t.blog.authorBio}</p>
        <a href={ALBIN_URL}>{t.blog.authorLink}</a>
      </aside>
      )}
      {collab ? (
      <aside class="cend">
        <div class="cend-b">
          <JournalHeadline text={t.blog.endHeadline} level="h2" align="left" size="26px" />
          <p>{t.blog.endSub}</p>
          <PlayStoreBadge locale={locale} href={playUrl} alt={t.alt.playStoreBadge} size="small" />
        </div>
        <div class="cend-a">
          <img src={albitWordmark.src} alt="AlbIT" width="132" height="35" loading="lazy" decoding="async" />
          <p>{t.blog.collabAlbit}</p>
          <a href={ALBIT_URL}>{t.blog.collabAlbitLink}<span aria-hidden="true"> ↗</span></a>
        </div>
      </aside>
      ) : (
      <aside class="aend">
        <div>
          <JournalHeadline text={t.blog.endHeadline} level="h2" align="left" size="28px" />
          <p>{t.blog.endSub}</p>
        </div>
        <PlayStoreBadge locale={locale} href={playUrl} alt={t.alt.playStoreBadge} size="small" />
      </aside>
      )}
      {more.length > 0 && (
      <section class="amore" aria-labelledby="amore-h">
        <h2 id="amore-h" class="amore-h">{t.blog.moreNotes}</h2>
        <div class="amore-grid">{more.map((n) => <NoteCard note={n} headingLevel="h3" />)}</div>
      </section>
      )}
      <nav class="aback" aria-label={t.blog.kicker}>
        <a href={fieldNotesHref(locale)}><span aria-hidden="true">← </span>{t.blog.allNotes}</a>
        <a href={`${home}#how-it-works`}>{t.blog.seeHow}</a>
      </nav>
    </article>
  </main>
  <Footer locale={locale} switchLangHref={otherPath} />
</Layout>

<script>
  // The reading line (2026-10-10): how much of the article is read, from its top at the top of the window to its end at
  // the bottom. Only transform changes, once per frame while scrolling.
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  const sheet = document.querySelector<HTMLElement>('.asheet');
  if (bar && sheet) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = sheet.getBoundingClientRect();
      const span = r.height - innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 1;
      bar.style.transform = `scaleX(${p.toFixed(4)})`;
    };
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .aprog { position: fixed; top: env(safe-area-inset-top, 0px); left: 0; right: 0; z-index: 101; height: 3px; pointer-events: none; }
  .aprog span { display: block; height: 100%; background: var(--rust); transform: scaleX(0); transform-origin: 0 50%; }
  .aauthor { display: grid; gap: 4px; margin: 54px 0 0; padding: 26px 0 0; border-top: 1px solid var(--line); }
  .aauthor-k { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--rust); }
  .aauthor-n { margin: 4px 0 0; font-family: var(--font-serif); font-size: 24px; line-height: 1.15; color: var(--ink); }
  .aauthor-b { margin: 4px 0 0; font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 46ch; }
  .aauthor a { justify-self: start; margin-top: 8px; font-size: 14px; font-weight: 600; color: var(--rust); text-decoration: underline; text-decoration-color: rgba(154, 69, 38, .45); text-underline-offset: 4px; }
  .aauthor a:hover { text-decoration-color: currentColor; }
  .amore { margin: 10px 0 34px; }
  .amore-h { margin: 0 0 18px; font-size: 26px; line-height: 1.15; color: var(--ink); }
  .amore-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .aby { margin: 14px 0 0; font-size: 14px; font-weight: 600; }
  .ameta { margin: 10px 0 0; font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .asheet { position: relative; max-width: 760px; margin: 0 auto; padding: 52px 60px 10px; }
  /* The light peach of the site (2026-10-10), the same as the Birdy half of the collab's end card. */
  .aend { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin: 44px 0 30px; padding: 30px 32px; border-radius: 18px; background: var(--peach); color: var(--ink); box-shadow: 0 0 0 1px var(--line); --jh-ink: var(--ink); --jh-accent: var(--rust); }
  .aend p { margin: 8px 0 0; font-size: 14px; color: var(--muted); }
  .aback { display: flex; justify-content: space-between; gap: 16px; font-size: 14px; font-weight: 600; color: var(--rust); padding: 22px 0 60px; border-top: 1px solid var(--line); }
  /* The title on the paper under the picture, centred (2026-10-10: every note, the way the collab note reads). The collab
     (birdy-x-albit) has the hero where the brands meet above it; every other note its picture as a plate. */
  .chead { position: relative; }
  .ctitle { max-width: 860px; margin: 0 auto; padding: 54px 24px 6px; text-align: center; color: var(--ink); }
  .ctitle :global(.kick) { justify-content: center; }
  .ch1 { margin: 14px auto 0; font-size: clamp(38px, 5vw, 62px); line-height: 1.04; letter-spacing: -.02em; max-width: 18ch; text-wrap: balance; overflow-wrap: anywhere; hyphens: auto; }
  /* AlbIT's gold, darkened until it clears 3:1 as large text on the paper (scripts/check-contrast.mjs). */
  .ch1-x { color: var(--albit-gold-ink); padding: 0 .08em; }
  .ctitle .aby a { color: var(--ink); border-bottom: 1px solid var(--line); padding-bottom: 1px; }
  .ctitle .aby a:hover { border-bottom-color: var(--rust); }
  /* The note's picture as a plate on the paper (2026-10-10): whole, nothing laid over it (Albin's photo rule: no tone
     over a photo, text beside or under it), at the notes' own 1600 × 840. */
  .phead { position: relative; padding-top: 28px; }
  .pfig { max-width: 1048px; margin-top: 0; margin-bottom: 0; }
  .aplate { overflow: hidden; border-radius: 22px; background: var(--peach); box-shadow: 0 0 0 1px var(--line), 0 24px 48px -26px rgba(var(--dark-rgb), .35); }
  .aplate :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1600 / 840; object-fit: cover; }
  .cap { width: fit-content; margin: 10px 8px 0 auto; font-family: var(--font-script); font-weight: 700; font-size: 20px; line-height: 1.2; color: var(--rust); transform: rotate(-2deg); }
  .cend { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); margin: 52px 0 30px; border-radius: 18px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  .cend-b { padding: 30px 32px; background: var(--peach); --jh-ink: var(--ink); --jh-accent: var(--rust); }
  .cend-b p { margin: 8px 0 18px; font-size: 14px; color: var(--muted); }
  .cend-a { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 32px; background: var(--albit-ink); color: #F5F5F3; }
  .cend-a img { display: block; width: 132px; height: auto; }
  .cend-a p { margin: 0; font-size: 14px; line-height: 1.6; color: #F5F5F3; }
  .cend-a a { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--albit-gold); border-bottom: 1px solid rgba(201, 162, 39, .5); padding-bottom: 1px; }
  .cend-a a:hover { border-bottom-color: var(--albit-gold); }
  .cend-a :global(:focus-visible) { outline-color: var(--albit-gold); }
  @media (max-width: 760px) {
    .asheet { padding: 34px 20px 6px; }
    .aend { flex-direction: column; align-items: flex-start; }
    .ctitle { padding: 36px 20px 0; }
    .phead { padding-top: 16px; }
    .aplate { border-radius: 14px; }
    .cap { font-size: 18px; }
    .cend { grid-template-columns: 1fr; }
    .amore-grid { grid-template-columns: 1fr; }
    .cend-b, .cend-a { padding: 26px 22px; }
  }
</style>
