---
import Wordmark from './ui/Wordmark.astro';
import { type Locale, getCopy } from '../lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = getCopy(locale);
const home = locale === 'sv' ? '/sv/' : '/';
---

<footer class="footer">
  <div class="inner">
    <div class="brand-block">
      <Wordmark size="45px" alt={t.alt.wordmark} color="#f8f7ed" />
      <p>{locale === 'sv' ? 'En egen plats för varje fågel du möter.' : 'A place for every bird you meet.'}</p>
    </div>
    <div class="link-block">
      <p class="heading">{locale === 'sv' ? 'Utforska' : 'Explore'}</p>
      <a href={`${home}#loop`}>{t.nav.howItWorks}</a>
      <a href={`${home}#glimpse`}>{t.nav.inside}</a>
      <a href={`${home}#coverage`}>{t.coverage.eyebrow}</a>
      <a href={`${home}#faq`}>{t.nav.faq}</a>
    </div>
    <div class="link-block">
      <p class="heading">{locale === 'sv' ? 'Birdy' : 'Birdy'}</p>
      {t.footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
  <div class="bottom"><span>© 2026 Birdy · {locale === 'sv' ? 'Skapad i Sverige' : 'Made in Sweden'}</span><span>{locale === 'sv' ? 'För nyfikna ögon och öron.' : 'For curious eyes and ears.'}</span></div>
</footer>

<style>
  .footer { background: var(--color-rust-shadow); color: #fff4e7; padding: 4.5rem clamp(1.5rem,6vw,5rem) 1.8rem; }
  .inner { max-width: 1260px; margin: auto; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem; }
  .brand-block p { margin: 1.25rem 0 0; color: #e9cbb6; max-width: 17rem; line-height: 1.5; }
  .link-block { display: flex; flex-direction: column; align-items: start; gap: .85rem; }
  .heading { color: var(--color-apricot); font-size: .82rem; font-weight: 600; margin: 0 0 .4rem; }
  .link-block a { font-size: .84rem; color: #f2ddcb; transition: color .2s; }
  .link-block a:hover { color: var(--color-apricot); }
  .bottom { max-width: 1260px; margin: 4.5rem auto 0; padding-top: 1.3rem; border-top: 1px solid rgba(255,255,255,.17); display: flex; justify-content: space-between; gap: 1rem; color: #d3b8a8; font-size: .72rem; }
  @media (max-width: 680px) { .inner { grid-template-columns: 1fr 1fr; gap: 3rem 2rem; } .brand-block { grid-column: 1 / -1; } .bottom { flex-direction: column; margin-top: 3rem; } }
</style>
