---
import Wordmark from './ui/Wordmark.astro';
import DeckleEdge from './ui/DeckleEdge.astro';
import { type Locale, getCopy } from '../lib/i18n';
import { fieldNotesHref } from '../lib/field-notes';
import { albitProductHref, CONTACT_EMAIL, LOOPLEAD_URL } from '../lib/links';
import { footerSpecies } from '../lib/species-nav.mjs';
import { COMMON_QIDS, footerGroups, getAllSpecies, groupHref, hubHref, speciesHref } from '../lib/species';

// edgeColor: the colour of whatever sits above the footer; it tears down into the footer (spec §6).
interface Props { locale: Locale; switchLangHref?: string; edgeColor?: string }
const { locale, switchLangHref, edgeColor = 'var(--paper)' } = Astro.props;
const t = getCopy(locale);
const home = locale === 'sv' ? '/sv/' : '/';
const blogPrefix = locale === 'sv' ? '/sv' : '';
// The species column only once a species is built, the "Common species" row only once one of the twelve is
// (Task 7's review): species are published one at a time, so for a while there can be a column but no row.
const allSpecies = await getAllSpecies();
const { column: speciesColumn, common } = footerSpecies(allSpecies, COMMON_QIDS);
// Indexed groups only (Task 13's review): a group under three species has noindex, so the footer of every page
// shouldn't point there. "All species" is always there.
const topGroups = footerGroups(allSpecies);
---

<footer class="footer">
  <DeckleEdge color={edgeColor} />
  <div class="wrap">
    <div class:list={['fgrid', { 'fgrid--species': speciesColumn }]}>
      <div class="fbrand">
        <a href={home} aria-label="Birdy"><Wordmark size="38px" alt={t.alt.wordmark} color="var(--apricot)" /></a>
        <p class="tag">{t.footer.tagline}</p>
        <div class="sibling">
          <p class="sib-kick">{t.footer.workshop}</p>
          <a class="sib-link" href={LOOPLEAD_URL}>
            <svg class="sib-mark" width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" fill="#4d7f58" /><path d="M8 16 Q 16 9, 24 16" stroke="#080a0d" stroke-width="2" fill="none" stroke-linecap="round" /><circle cx="8" cy="16" r="2" fill="#080a0d" /><circle cx="24" cy="16" r="2" fill="#080a0d" /></svg>
            <span class="sib-text"><strong>LoopLead</strong> <span>{t.footer.loopleadLine}</span></span>
          </a>
        </div>
      </div>
      {speciesColumn && (
        <div class="col">
          <h2 class="fh">{t.footer.species}</h2>
          {topGroups.map((g) => <a href={groupHref(g, locale)}>{g.name[locale]}</a>)}
          <a href={hubHref(locale)}>{t.footer.allSpecies}</a>
        </div>
      )}
      <div class="col">
        <h2 class="fh">{t.footer.explore}</h2>
        <a href={`${home}#how-it-works`}>{t.nav.howItWorks}</a>
        <a href={`${home}#app`}>{t.nav.app}</a>
        <a href={`${home}#premium`}>{t.nav.premium}</a>
        <a href={`${home}#faq`}>{t.nav.faq}</a>
      </div>
      <div class="col">
        <h2 class="fh">{t.footer.read}</h2>
        <a href={fieldNotesHref(locale)}>{t.nav.fieldNotes}</a>
        <a href={`${blogPrefix}/blog/why-birdy/`}>{t.footer.whyBirdy}</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.writeUs}</a>
      </div>
      <div class="col">
        <h2 class="fh">{t.footer.information}</h2>
        <a href="/legal/privacy/">{t.footer.privacyPolicy}</a>
        <a href="/legal/terms/">{t.footer.terms}</a>
        <a href="/legal/data-safety/">{t.footer.dataSafety}</a>
        <a href={switchLangHref ?? t.nav.switchLangHref} lang={locale === 'sv' ? 'en' : 'sv'}>{t.footer.otherLanguage}</a>
      </div>
    </div>
    {common.length > 0 && (
      <p class="fpop"><span class="fpop-h">{t.footer.commonSpecies}</span>{common.map((s) => <a href={speciesHref(s, locale)}>{s.names[locale]}</a>)}</p>
    )}
    <div class="fbot">
      <span>{t.footer.copyright}</span>
      <span>{t.footer.builtBy} <a href={albitProductHref(locale)}>AlbIT</a></span>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--dark-deep); color: #E9E2D2; padding: 70px 0 26px; }
  .footer :global(:focus-visible) { outline-color: var(--apricot); }
  .fgrid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; }
  /* The species column, once a species is built (before that the grid keeps its three columns). */
  .fgrid--species { grid-template-columns: 1.6fr repeat(4, 1fr); }
  .tag { margin: 12px 0 0; font-family: var(--font-script); font-size: 21px; line-height: 1.2; color: var(--apricot); }
  .col { display: flex; flex-direction: column; align-items: flex-start; }
  .fh { font-family: var(--font-sans); line-height: 1.5; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--apricot); margin: 0 0 14px; font-weight: 600; }
  .col a { font-size: 14px; color: rgba(233, 226, 210, .82); margin-bottom: 10px; transition: color .2s; }
  .col a:hover { color: var(--apricot); }
  /* alpha checked in scripts/check-contrast.mjs */
  .fbot { display: flex; justify-content: space-between; gap: 20px; margin-top: 56px; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .1); font-size: 12.5px; color: rgba(233, 226, 210, .55); }
  .fbot a { color: var(--apricot); text-decoration: underline; text-underline-offset: 3px; }
  .fpop { margin: 40px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; font-size: 13.5px; }
  .fpop-h { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--apricot); font-weight: 600; margin-right: 4px; }
  /* same colour as .col a (alpha checked in scripts/check-contrast.mjs) */
  .fpop a { color: rgba(233, 226, 210, .82); text-decoration: underline; text-decoration-color: rgba(233, 226, 210, .3); text-underline-offset: 3px; transition: color .2s; }
  .fpop a:hover { color: var(--apricot); }
  .sibling { margin-top: 28px; max-width: 320px; }
  /* alpha checked in scripts/check-contrast.mjs */
  .sib-kick { margin: 0 0 10px; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; font-weight: 600; color: rgba(233, 226, 210, .6); }
  .sib-link { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid rgba(255, 255, 255, .14); border-radius: 10px; transition: border-color .2s, background-color .2s; }
  .sib-link:hover { border-color: rgba(242, 178, 122, .55); background: rgba(255, 255, 255, .03); }
  .sib-mark { flex: none; display: block; }
  .sib-text { display: flex; flex-direction: column; gap: 2px; }
  .sib-text strong { font-size: 14px; font-weight: 600; color: #E9E2D2; }
  .sib-text span { font-size: 12.5px; line-height: 1.4; color: rgba(233, 226, 210, .7); }
  /* With the species column: four link columns are too narrow next to the brand below about 1 000 px, so the
     brand takes its own row and the links three columns (Task 13's review). */
  @media (min-width: 761px) and (max-width: 1000px) {
    .fgrid--species { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fgrid--species .fbrand { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .fgrid { grid-template-columns: 1fr 1fr; }
    .fbrand { grid-column: 1 / -1; }
    .fbot { flex-direction: column; }
  }
</style>
