---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Kicker from './ui/Kicker.astro';
import JournalHeadline from './ui/JournalHeadline.astro';
import DeckleEdge from './ui/DeckleEdge.astro';
import NoteCard from './NoteCard.astro';
import NoteFlight from './NoteFlight.astro';
import { getFieldNotes, fieldNotesHref } from '../lib/field-notes';
import { type Locale, getCopy } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getCopy(locale);
const [latest, ...rest] = await getFieldNotes(locale);
// Columns for the cards under the newest (2026-10-10): pairs for two or four, threes otherwise, so a short list fills
// its rows; a single card gets the pair's width rather than a third of the row.
const cols = rest.length === 1 || rest.length === 2 || rest.length === 4 ? 2 : 3;
const otherLocale: Locale = locale === 'sv' ? 'en' : 'sv';
---

<Layout locale={locale} pathname={fieldNotesHref(locale)} title={t.blog.indexTitle} description={t.blog.indexDescription}>
  <Nav locale={locale} switchLangHref={fieldNotesHref(otherLocale)} />
  <main id="main" tabindex="-1">
    <header class="bhead">
      <div class="wrap">
        <Kicker text={t.blog.kicker} />
        <JournalHeadline text={t.blog.headline} level="h1" align="left" size="clamp(40px, 5vw, 60px)" />
        <p class="blead">{t.blog.lead}</p>
      </div>
      <DeckleEdge color="var(--paper)" side="bottom" />
    </header>
    <div class="wrap list" data-note-flight>
      {latest && <div class="first"><NoteCard note={latest} size="large" headingLevel="h2" priority /></div>}
      {rest.length > 0 && <div class="grid" style={`--cols:${cols}`}>{rest.map((note) => <NoteCard note={note} headingLevel="h2" />)}</div>}
    </div>
    <NoteFlight />
  </main>
  <Footer locale={locale} switchLangHref={fieldNotesHref(otherLocale)} />
</Layout>

<style>
  /* The site's light peach paper, lit like the home hero (2026-10-10: no brown band), torn into the list below; the
     newest note starts below the tear, not across it (2026-10-10, "more clean"). */
  .bhead { position: relative; color: var(--ink); background-color: var(--peach); background-image: linear-gradient(0deg, var(--peach) 0, rgb(253 229 203 / 0) 120px), radial-gradient(130% 120% at 70% 30%, var(--peach-hi) 0%, var(--peach) 45%, var(--peach-lo) 100%); padding: 52px 0 64px; }
  .bhead .blead { color: var(--muted); font-size: 17px; line-height: 1.6; max-width: 36rem; margin: 18px 0 0; text-wrap: pretty; }
  .list { padding-bottom: 96px; }
  .first { margin-top: 30px; }
  .grid { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  @media (max-width: 760px) {
    .bhead { padding: 28px 0 50px; }
    .first { margin-top: 22px; }
    .grid { grid-template-columns: 1fr; gap: 20px; margin-top: 20px; }
  }
</style>
