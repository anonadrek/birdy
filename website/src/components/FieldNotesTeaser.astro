---
import { getFieldNotes, fieldNoteHref, fieldNotesHref } from '../lib/field-notes';
import { type Locale } from '../lib/i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const latest = (await getFieldNotes(locale))[0];
const sv = locale === 'sv';
---

{latest && <section class="field-notes" aria-labelledby="field-notes-title">
  <div class="inner" data-reveal>
    <div class="intro">
      <p class="label">{sv ? 'Fältanteckningar' : 'Field Notes'}</p>
      <h2 id="field-notes-title">{sv ? 'Läs mer om Birdy.' : 'Read more about Birdy.'}</h2>
      <p class="intro-text">{sv ? 'Här skriver vi om appen, fåglarna den känner igen och besluten bakom funktionerna.' : 'Here we write about the app, the birds it identifies and the decisions behind its features.'}</p>
      <a class="all-notes" href={fieldNotesHref(locale)}>{sv ? 'Alla fältanteckningar' : 'All field notes'} <span aria-hidden="true">↗</span></a>
    </div>
    <a class="featured" href={fieldNoteHref(latest)}>
      <span class="featured-top"><span>{latest.data.category}</span><time datetime={latest.data.date.toISOString().slice(0, 10)}>{latest.data.date.toLocaleDateString(sv ? 'sv-SE' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
      <span class="featured-title">{latest.data.title}</span>
      <span class="featured-description">{latest.data.description}</span>
      <span class="read-note">{sv ? 'Läs artikeln' : 'Read the article'} <span aria-hidden="true">↗</span></span>
    </a>
  </div>
</section>}

<style>
  .field-notes { background: #fff8ed; border-top: 1px solid var(--color-paper-edge); border-bottom: 1px solid var(--color-paper-edge); padding: clamp(4.5rem,8vw,8rem) clamp(1.5rem,6vw,5rem); }
  .inner { max-width: 1260px; margin: auto; display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,.85fr); gap: clamp(3rem,7vw,8rem); align-items: end; }
  .label { color: var(--color-orange); font-weight: 600; font-size: .82rem; margin: 0 0 1.5rem; }
  h2 { font-size: clamp(3.5rem,7vw,7.2rem); max-width: 11ch; letter-spacing: -.04em; line-height: .98; margin: 0; text-wrap: balance; }
  .intro-text { max-width: 35rem; margin: 2rem 0 0; color: var(--color-marginalia-ink); font-size: 1.05rem; line-height: 1.65; }
  .all-notes { display: inline-flex; gap: 1.5rem; margin-top: 1.7rem; color: var(--color-orange); border-bottom: 1px solid currentColor; padding-bottom: .35rem; font-weight: 600; font-size: .9rem; }
  .featured { display: flex; flex-direction: column; border-top: 2px solid var(--color-rust-shadow); border-bottom: 1px solid var(--color-paper-edge); padding: 1.1rem 0 1.5rem; min-height: 19rem; transition: border-color .2s; }
  .featured:hover { border-top-color: var(--color-orange); }
  .featured-top { display: flex; justify-content: space-between; gap: 1rem; color: var(--color-marginalia-ink); font-size: .76rem; }
  .featured-title { display: block; font: 400 clamp(2rem,3.4vw,3.5rem)/1.09 var(--font-serif); letter-spacing: -.025em; margin: 2.2rem 0 1rem; hyphens: auto; overflow-wrap: anywhere; }
  .featured-description { color: var(--color-marginalia-ink); line-height: 1.55; max-width: 38ch; }
  .read-note { margin-top: auto; padding-top: 2rem; color: var(--color-orange); font-size: .88rem; font-weight: 600; display: flex; justify-content: space-between; }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; gap: 3rem; } .featured { min-height: 16rem; } h2 { max-width: 13ch; } }
</style>
