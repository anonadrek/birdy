---
// The flight between the notes' pictures (spec 2026-10-10, "Bloggen som en flygväg"): one decorative SVG layer per
// list marked data-note-flight, drawn from src/lib/note-flight.mjs. The cards' text lies in front of the flight, so the
// birds go behind it and come out in the next picture; where a card's text stands right across the way (stacked
// cards), they climb the page's right margin instead. Without JavaScript the cards are as before.
import { MARK } from './hero/flock-data.mjs';
---

<svg class="nflight-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <defs><path id="nf-mark" d={MARK.path}></path></defs>
</svg>

<script>
  import { pairFlights, at, flightCurve, textInTheWay, nearestTheMargin, marginLane, laneFlight, birdsAlong, clearOf, birdTransform } from '../lib/note-flight.mjs';

  const NS = 'http://www.w3.org/2000/svg';
  type Rect = { x: number; y: number; w: number; h: number };
  type Point = { x: number; y: number };
  type Cubic = [Point, Point, Point, Point];

  const json = <T,>(s: string | undefined): T | null => {
    try { return s ? (JSON.parse(s) as T) : null; } catch { return null; }
  };

  const finite = (n: number) => Number.isFinite(n);
  const isPt = (p: Point | null | undefined): p is Point => !!p && finite(p.x) && finite(p.y);
  const isRect = (r: Rect | null | undefined): r is Rect => !!r && finite(r.x) && finite(r.y) && finite(r.w) && finite(r.h);

  /**
   * Where an element sits in the list, from its layout offsets rather than its painted box: the front page's reveal
   * slides the cards up 20px as they come into view, and a card lifts under the pointer, and the layer must match
   * where the cards come to rest, not where they happened to be when it was drawn.
   */
  function rectIn(el: HTMLElement, list: HTMLElement): Rect {
    let x = 0;
    let y = 0;
    let n: Element | null = el;
    while (n instanceof HTMLElement && n !== list) {
      x += n.offsetLeft;
      y += n.offsetTop;
      n = n.offsetParent;
    }
    if (n === list) return { x, y, w: el.offsetWidth, h: el.offsetHeight };
    const o = list.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    return { x: r.left - o.left, y: r.top - o.top, w: r.width, h: r.height };
  }

  /** Whether a point drawn from the picture's own coordinates still lands inside the box that clips it. */
  function within(p: Point, box: Rect): boolean {
    return p.x >= box.x && p.x <= box.x + box.w && p.y >= box.y && p.y <= box.y + box.h;
  }

  /** One axis of an object position computed style, as a 0 to 1 fraction. Defaults to the centre. */
  function posFraction(part: string | undefined): number {
    const m = part && /^(-?[\d.]+)%$/.exec(part.trim());
    return m ? parseFloat(m[1]) / 100 : 0.5;
  }

  /**
   * The picture as it is actually drawn inside its box: object-fit cover (and maybe object-position) means a box
   * whose ratio is not the notes' own 1600 by 840 (the large card's picture stretches with its row) makes the drawn
   * picture overflow the box on one axis. exit, land and avoid are the picture's own 0 to 1 coordinates, so they
   * belong on this rect, not the box. Falls back to the notes' own ratio while the image has not finished loading.
   */
  function drawnRect(box: Rect, art: HTMLElement): Rect {
    const img = art.querySelector('img');
    const natW = img?.naturalWidth || 0;
    const natH = img?.naturalHeight || 0;
    const ratio = natW > 0 && natH > 0 ? natW / natH : 1600 / 840;
    const boxRatio = box.w / box.h;
    let w: number;
    let h: number;
    if (boxRatio > ratio) { w = box.w; h = w / ratio; } else { h = box.h; w = h * ratio; }
    let posX = 0.5;
    let posY = 0.5;
    if (img) {
      const parts = getComputedStyle(img).objectPosition.split(' ');
      posX = posFraction(parts[0]);
      posY = posFraction(parts[1]);
    }
    return { x: box.x + (box.w - w) * posX, y: box.y + (box.h - h) * posY, w, h };
  }

  function draw(list: HTMLElement) {
    list.querySelector(':scope > svg.nflight')?.remove();
    const arts = [...list.querySelectorAll<HTMLElement>('[data-flight-art]')];
    const rects = arts.map((el) => rectIn(el, list));
    const drawn = arts.map((el, i) => drawnRect(rects[i], el));
    const texts = [...list.querySelectorAll<HTMLElement>('.ncard-body')].map((el) => rectIn(el, list));
    const cardsRight = Math.max(...[...list.querySelectorAll<HTMLElement>('.ncard')].map((el) => { const r = rectIn(el, list); return r.x + r.w; }));
    // The page's own edges, in the list's coordinates: a bird never reaches past them (nor into a scrollbar).
    const left = list.getBoundingClientRect().left + list.clientLeft;
    const pageLeft = 2 - left;
    const pageRight = document.documentElement.clientWidth - 2 - left;
    const blockers: Rect[] = [
      ...texts,
      { x: pageLeft - 1e5, y: -1e5, w: 1e5, h: 2e5 },
      { x: pageRight, y: -1e5, w: 1e5, h: 2e5 },
    ];
    arts.forEach((el, i) => {
      for (const a of (json<Rect[]>(el.dataset.avoid) ?? []).filter(isRect)) {
        blockers.push({ x: drawn[i].x + a.x * drawn[i].w, y: drawn[i].y + a.y * drawn[i].h, w: a.w * drawn[i].w, h: a.h * drawn[i].h });
      }
    });
    const lane = marginLane(cardsRight, pageRight);

    /** Where picture k's own trail leaves it, when its data is sound and the point lies inside the picture's box. */
    const exitOf = (k: number): Point | null => {
      const e = json<Point>(arts[k].dataset.exit);
      const p = isPt(e) ? at(drawn[k], e) : null;
      return p && within(p, rects[k]) ? p : null;
    };

    type Flight = { path: Cubic | Cubic[]; size: number; gap: number; thin: number };
    const flights: Flight[] = [];
    for (const p of pairFlights(rects)) {
      const start = exitOf(p.from);
      const land = json<Point>(arts[p.to].dataset.land);
      const end = isPt(land) ? at(drawn[p.to], land) : null;
      if (!start || !end || !within(end, rects[p.to])) continue;
      // Too short to read as a flight at all.
      if (Math.hypot(end.x - start.x, end.y - start.y) < 60) continue;
      // Stacked cards: the upper card's text stands right across the way, so the birds climb the margin past it,
      // leaving from the picture nearest the margin and crossing its empty top to get there (or, with no margin to
      // climb, there is no flight rather than a few stray birds).
      const box = p.dir === 'up' ? textInTheWay(start, end, texts) : null;
      if (box) {
        const from = nearestTheMargin(rects, p.from);
        const out = exitOf(from);
        if (lane && out) {
          const level = Math.max(out.y, rects[from].y + 12);
          flights.push({ path: laneFlight(out, end, box, lane.x, level), size: lane.size, gap: 34, thin: 0.45 });
        }
        continue;
      }
      flights.push({ path: flightCurve(start, end, p.dir), size: 11, gap: 26, thin: 0 });
    }
    if (!flights.length) return;

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'nflight');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    flights.forEach((f, fi) => {
      const g = document.createElementNS(NS, 'g');
      g.setAttribute('class', 'nf-flight');
      const birds = clearOf(birdsAlong(f.path, { size: f.size, gap: f.gap, thin: f.thin, seed: 101 + fi * 7 }), blockers);
      birds.forEach((bird, i) => {
        const use = document.createElementNS(NS, 'use');
        use.setAttribute('href', '#nf-mark');
        use.setAttribute('transform', birdTransform(bird.x, bird.y, bird.size, bird.rot, bird.mirror));
        use.setAttribute('fill', bird.colour);
        use.setAttribute('fill-opacity', String(Math.round(bird.alpha * 100) / 100));
        use.style.setProperty('--i', String(i));
        g.append(use);
      });
      svg.append(g);
    });
    list.append(svg);
  }

  const lists = [...document.querySelectorAll<HTMLElement>('[data-note-flight]')];
  let frame = 0;
  const redraw = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(() => lists.forEach(draw)); };
  if (lists.length) {
    redraw();
    document.fonts?.ready.then(redraw);
    const ro = new ResizeObserver(redraw);
    lists.forEach((l) => ro.observe(l));
    // The page's width (and so the margin the birds may climb) can change without the list changing size. Only the
    // width: a phone's address bar sliding away changes the height alone and must not redraw the birds.
    let width = document.documentElement.clientWidth;
    window.addEventListener('resize', () => {
      if (document.documentElement.clientWidth === width) return;
      width = document.documentElement.clientWidth;
      redraw();
    });
    // The birds fade in once, when the list comes into view; a later redraw (a picture loading further down, a turned
    // phone) shows them at once instead of fading them in again.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('nflight-go');
        io.unobserve(e.target);
        setTimeout(() => e.target.classList.add('nflight-flown'), 2500);
      }
    }, { threshold: 0.2 });
    lists.forEach((l) => io.observe(l));
    // Redraw once a picture finishes loading, so the drawn rect uses its real naturalWidth and naturalHeight rather
    // than the fallback ratio (matters most for the lazy loaded cards, which have not loaded at the first redraw).
    for (const img of document.querySelectorAll<HTMLImageElement>('[data-flight-art] img')) {
      img.addEventListener('load', redraw, { once: true });
    }
  }
</script>

<style is:global>
  .nflight-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  [data-note-flight] { position: relative; }
  [data-note-flight] > svg.nflight { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  @media (prefers-reduced-motion: no-preference) {
    html.motion-ready [data-note-flight]:not(.nflight-flown) > svg.nflight use { opacity: 0; }
    html.motion-ready [data-note-flight].nflight-go:not(.nflight-flown) > svg.nflight use { animation: nf-in .5s ease-out both; animation-delay: calc(var(--i) * 70ms); }
  }
  @keyframes nf-in { from { opacity: 0; } to { opacity: 1; } }
</style>
