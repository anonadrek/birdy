---
import { Image } from 'astro:assets';
import { type Locale, getCopy } from '../lib/i18n';
import p1 from '../assets/panorama/panorama_1.png';
import p2 from '../assets/panorama/panorama_2.png';
import p3 from '../assets/panorama/panorama_3.png';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getCopy(locale);

// Order matters: 1 → 2 → 3 left-to-right. The paper background and the copper
// bird-mark flow across the seams, so the three panes read as one continuous
// scene (paper → moss-green). Decorative — the section's aria-label describes
// the whole banner, so the individual images carry empty alt text.
const panes = [p1, p2, p3];
---

<section class="panorama" aria-label={t.alt.panorama}>
  <div class="strip">
    {panes.map((src) => (
      <Image
        src={src}
        alt=""
        widths={[360, 540, 720, 960, 1280]}
        sizes="(min-width: 1920px) 640px, 33vw"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    ))}
  </div>
</section>

<style>
  .panorama {
    width: 100%;
    max-width: 1920px;
    /* Full-bleed banner, centered on ultra-wide; breathing room above/below */
    margin-inline: auto;
    margin-block: clamp(1rem, 4vw, 3rem);
  }
  .strip {
    display: flex;
    width: 100%;
    line-height: 0;
  }
  /*
   * flex: 1 1 0 splits the row into three exact, pixel-filling thirds (no
   * leftover sub-pixel gap → no hairline seam). aspect-ratio 9/16 keeps every
   * pane the same height, so the panorama blends edge-to-edge.
   */
  .strip :global(img) {
    flex: 1 1 0;
    min-width: 0;
    height: auto;
    display: block;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }
</style>
