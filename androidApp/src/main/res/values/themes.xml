<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared by every API level's Theme.Birdy.Starting (values-v27 adds the navigation bar). -->
    <style name="Theme.Birdy.Starting.Base" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Birdy</item>
        <!-- The launch window is paper: dark status bar icons from the very first frame
             (release 1.3.0 Task 7g; API 30 showed white icons until onCreate ran). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Birdy.Starting" parent="Theme.Birdy.Starting.Base" />
    <style name="Theme.Birdy" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_bg</item>
    </style>
</resources>
